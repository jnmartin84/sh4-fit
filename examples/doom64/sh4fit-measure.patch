 #define NS_PER_VBL 16666667
 
+#ifdef SH4FIT_PERF
+// Sh4Fit A/B measurement. Every 300 game tics (10 s) and at the end of each
+// MiniLoop, print the CPU time spent in ticker and drawer per frame plus the
+// SH-4 performance counters (dcload console or serial). The counter mode
+// advances once per attract-mode pass: IC misses, OC misses, stall cycles.
+#include <arch/timer.h>
+#include "sh4fit_perf.h"
+
+#define SH4FIT_WINDOW_TICS 300
+
+static int sh4fit_pass = -1;
+static int sh4fit_session;
+static char sh4fit_where[32];
+static int sh4fit_window_tic;
+static uint64_t sh4fit_ticker_ns;
+static uint64_t sh4fit_drawer_ns;
+
+static void sh4fit_window_report(void)
+{
+	char label[160];
+	uint32_t frames = sh4fit_perf_frames ? sh4fit_perf_frames : 1;
+
+	snprintf(label, sizeof(label), "pass %d session %d %s tics %d-%d cpu %lu us/frame (ticker %lu drawer %lu)",
+		 sh4fit_pass, sh4fit_session, sh4fit_where, sh4fit_window_tic, gametic,
+		 (unsigned long)((sh4fit_ticker_ns + sh4fit_drawer_ns) / frames / 1000),
+		 (unsigned long)(sh4fit_ticker_ns / frames / 1000),
+		 (unsigned long)(sh4fit_drawer_ns / frames / 1000));
+	sh4fit_perf_report(label);
+	sh4fit_ticker_ns = 0;
+	sh4fit_drawer_ns = 0;
+	sh4fit_window_tic = gametic;
+}
+
+static void sh4fit_session_begin(void (*drawer)(void))
+{
+	sh4fit_session++;
+	if (drawer == P_Drawer)
+		snprintf(sh4fit_where, sizeof(sh4fit_where), "map %d%s", gamemap, demoplayback ? " demo" : "");
+	else
+		snprintf(sh4fit_where, sizeof(sh4fit_where), "screen");
+	printf("sh4fit pass %d session %d %s start\n", sh4fit_pass, sh4fit_session, sh4fit_where);
+	sh4fit_perf_start(sh4fit_pass < 0 ? SH4FIT_PERF_IC : (sh4fit_perf_mode_t)(sh4fit_pass % 3));
+	sh4fit_ticker_ns = 0;
+	sh4fit_drawer_ns = 0;
+	sh4fit_window_tic = gametic;
+}
+
+static void sh4fit_session_end(void)
+{
+	if (sh4fit_perf_frames)
+		sh4fit_window_report();
+	sh4fit_perf_stop();
+}
+#endif
+
