 void reios_sys_font() {
-	printf("reios_sys_font\n");
+	// r1 selects: 0 = font address, 1 = lock, 2 = unlock. Without a BIOS image
+	// the font area reads blank, but KallistiOS's bfont spins until the lock
+	// succeeds, so it has to.
+	switch (Sh4cntx.r[1]) {
+	case 0: Sh4cntx.r[0] = 0xA0100020; break;
+	case 1: case 2: Sh4cntx.r[0] = 0; break;
+	default:
+		printf("reios_sys_font: unknown function %u\n", Sh4cntx.r[1]);
+		Sh4cntx.r[0] = -1;
+	}
 }
 
