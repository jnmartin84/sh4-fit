diff --git a/libswirl/hw/sh4/interpr/sh4_trace_mem.h b/libswirl/hw/sh4/interpr/sh4_trace_mem.h
new file mode 100644
index 0000000..24a3d3f
--- /dev/null
+++ b/libswirl/hw/sh4/interpr/sh4_trace_mem.h
@@ -0,0 +1,43 @@
+/*
+	This file is part of libswirl
+*/
+#include "license/bsd"
+
+/*
+	Routes the interpreter's data accesses through the SH4XTRC1 hooks. Include
+	it after hw/sh4/sh4_mem.h in the opcode handlers (sh4_opcodes.cpp and
+	sh4_fpu.cpp) only; instruction fetches are hooked in sh4_interpreter.cpp.
+*/
+#pragma once
+#include "hw/sh4/sh4_mem.h"
+#include "hw/sh4/sh4_trace.h"
+
+static INLINE u8 sh4t_ReadMem8(u32 addr) { sh4trace_load(addr); return ReadMem8(addr); }
+static INLINE u16 sh4t_ReadMem16(u32 addr) { sh4trace_load(addr); return ReadMem16(addr); }
+static INLINE u32 sh4t_ReadMem32(u32 addr) { sh4trace_load(addr); return ReadMem32(addr); }
+static INLINE u64 sh4t_ReadMem64(u32 addr) { sh4trace_load(addr); return ReadMem64(addr); }
+
+static INLINE void sh4t_WriteMem8(u32 addr, u8 data) { sh4trace_store(addr, data); WriteMem8(addr, data); }
+static INLINE void sh4t_WriteMem16(u32 addr, u16 data) { sh4trace_store(addr, data); WriteMem16(addr, data); }
+static INLINE void sh4t_WriteMem32(u32 addr, u32 data) { sh4trace_store(addr, data); WriteMem32(addr, data); }
+static INLINE void sh4t_WriteMem64(u32 addr, u64 data) { sh4trace_store(addr, (u32)data); WriteMem64(addr, data); }
+
+// For movca.l, which is recorded as its own op rather than as a store.
+static INLINE void sh4t_WriteMem32_untraced(u32 addr, u32 data) { WriteMem32(addr, data); }
+
+#undef ReadMem8
+#undef ReadMem16
+#undef ReadMem32
+#undef ReadMem64
+#undef WriteMem8
+#undef WriteMem16
+#undef WriteMem32
+#undef WriteMem64
+#define ReadMem8 sh4t_ReadMem8
+#define ReadMem16 sh4t_ReadMem16
+#define ReadMem32 sh4t_ReadMem32
+#define ReadMem64 sh4t_ReadMem64
+#define WriteMem8 sh4t_WriteMem8
+#define WriteMem16 sh4t_WriteMem16
+#define WriteMem32 sh4t_WriteMem32
+#define WriteMem64 sh4t_WriteMem64
